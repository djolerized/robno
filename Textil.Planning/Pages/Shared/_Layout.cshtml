@inject Textil.Planning.Services.ICurrentUser CurrentUser
<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · Textil robno planiranje</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
<header class="top">
    <div class="top-in">
        <a class="brand" href="/">TEXTIL<b>.</b></a>
        <span class="sub">Robno planiranje</span>
        @if (CurrentUser.IsAuthenticated)
        {
            <nav class="nav">
                @if (CurrentUser.IsInRole(Roles.Director))
                {
                    <a href="/Admin/Users">Korisnici</a>
                }
            </nav>
        }
        <span class="spacer"></span>
        @if (CurrentUser.IsAuthenticated)
        {
            <form class="who" method="post" action="/Account/Logout">
                <span>@CurrentUser.DisplayName</span>
                <button type="submit" class="btn ghost sm on-dark">Odjava</button>
            </form>
        }
    </div>
</header>

<main class="wrap">
    @RenderBody()
</main>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
