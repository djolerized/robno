@* TempData keys: Message (ok), Warning, Error. Multiple lines are separated by \n and rendered as a list. *@
@{
    var boxes = new[] { ("Message", "ok-box", "status"), ("Warning", "warn-box", "status"), ("Error", "err-box", "alert") };
}
@foreach (var (key, css, role) in boxes)
{
    if (TempData[key] is string text)
    {
        var lines = text.Split('\n');
        <div class="@css" role="@role">
            @if (lines.Length == 1)
            {
                @lines[0]
            }
            else
            {
                <ul>@foreach (var line in lines) { <li>@line</li> }</ul>
            }
        </div>
    }
}
