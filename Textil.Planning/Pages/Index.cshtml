@page
@model Textil.Planning.Pages.IndexModel
@{
    ViewData["Title"] = "Početna";
    var isProcurement = Model.Roles.Contains(Roles.Procurement);
}

<div class="cycle-bar">
    <h1>Dobrodošli, @Model.DisplayName</h1>
    <span class="kv">Uloge
        @foreach (var role in Model.Roles)
        {
            <span class="pill">@Roles.Label(role)</span>
        }
    </span>
    @if (Model.ManagerName is not null)
    {
        <span class="kv">Plan šaljete na odobrenje <strong>@Model.ManagerName</strong></span>
    }
</div>

<section class="panel">
    <div class="panel-h"><h2>Otvoreni ciklusi</h2></div>
    <div class="panel-b">
        @if (Model.OpenCycles.Count == 0)
        {
            <p class="plain">Nema otvorenih ciklusa planiranja.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Ciklus</th>@if (isProcurement) { <th>Status</th> }<th>Period</th><th>Rok za unos</th><th class="num">SKU</th></tr></thead>
                <tbody>
                    @foreach (var c in Model.OpenCycles)
                    {
                        <tr>
                            <td class="sku">@if (isProcurement) { <a href="/Procurement/@c.Id">@c.Name</a> } else { @c.Name }</td>
                            @if (isProcurement)
                            {
                                <td><span class="pill @Display.PillClass(c.ProcurementStage)">@Display.Label(c.ProcurementStage)</span></td>
                            }
                            <td>@Display.Period(c.Months)</td>
                            <td>@Model.Time.Format(c.Deadline)</td>
                            <td class="num">@c.SkuCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <p class="row" style="margin-top:14px">
            @if (Model.Roles.Contains(Roles.Procurement))
            {
                <a class="btn" href="/Procurement">Slanje SKU prodaji</a>
            }
            @if (Model.Roles.Contains(Roles.Director))
            {
                <a class="btn" href="/Director/Cycles">Ciklusi</a>
                <a class="btn ghost" href="/Admin/Users">Korisnici i hijerarhija</a>
            }
        </p>
    </div>
</section>
